{
  "name": "open-hypergamy-gui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Onboarding GUI for OpenHypergamy. Built into src/open_hypergamy/gui/static.",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/copy-licenses.mjs && node scripts/copy-brand.mjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "preact": "10.29.8"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.64.1",
    "@preact/preset-vite": "2.10.6",
    "@types/node": "22.20.5",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}
