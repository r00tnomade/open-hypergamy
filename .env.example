# Reference only: ohg does not read .env. Export these in your shell (or launchd env);
# put secrets in the macOS Keychain with `ohg secrets set NAME`. Never commit real values.
OHG_HOME=
OHG_CONFIG=
OHG_LOG_LEVEL=
OHG_LLM_ENABLED=true
OHG_LLM_PROVIDER=freellmapi
OHG_LLM_BASE_URL=http://127.0.0.1:3001/v1
OHG_LLM_MODEL=auto:ohg-free
OHG_LLM_ALLOW_REMOTE_PUBLIC_CONTENT=true
OHG_FREELLMAPI_API_KEY=
OHG_TELEGRAM_ENABLED=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
